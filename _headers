/index.html
  Cache-Control: no-store

/*.html
  Cache-Control: no-store

# JS/CSS revalidate on each visit via ETag. After deploy, a normal reload
# picks up changes without requiring a hard refresh or manual "?v=" bumps.
/js/*
  Cache-Control: public, max-age=0, must-revalidate

/style.css
  Cache-Control: public, max-age=0, must-revalidate

# Icons and team logos rarely change, so a shorter but still long cache
# avoids re-downloading them on every repeat visit.
/icons/*
  Cache-Control: public, max-age=604800

/TeamLogo/*
  Cache-Control: public, max-age=604800

/manifest.json
  Cache-Control: public, max-age=86400
